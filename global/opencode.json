{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {
        "qwen/qwen3.5-9b": {
          "name": "Qwen 3.5 9B"
        },
        "qwen/qwen3.5-35b-a3b": {
          "name": "Qwen 3.5 35B"
        },
        "nemotron-3-nano-30b-a3b": {
          "name": "Nemotron 3 Nano 30B"
        },
        "mythomax-l2-13b": {
          "name": "MythoMax L2 13B"
        },
        "llama-2-7b-chat": {
          "name": "Llama 2 7B Chat"
        },
        "zai-org/glm-4.7-flash": {
          "name": "GLM 4.7 Flash"
        }
      }
    }
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "agent": {
    "general": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "summary": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "title": {
      "model": "github-copilot/claude-haiku-4.5"
    },
    "explore": {
      "model": "github-copilot/claude-haiku-4.5"
    }
  },
  "instructions": [
    "CONTRIBUTING.md",
    "instructions/INSTRUCTIONS.md",
    "rules/honcho.md",
    "../coding/skills/tdd-workflow/SKILL.md",
    "../coding/skills/security-review/SKILL.md",
    "../coding/skills/coding-standards/SKILL.md",
    "skills/git-town/SKILL.md"
  ],
  "permission": {
    "doom_loop": "deny",
    "mcp_*": "ask"
  },
  "mcp": {
    "grafana": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-grafana"
      ],
      "environment": {
        "GRAFANA_URL": "https://grafana.dev.salary-hero.com",
        "GRAFANA_SERVICE_ACCOUNT_TOKEN": "${GRAFANA_SERVICE_ACCOUNT_TOKEN}"
      },
      "enabled": false
    },
    "firefox-devtools": {
      "type": "local",
      "command": [
        "npx",
        "firefox-devtools-mcp@latest"
      ],
      "enabled": false
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ],
      "enabled": false
    },
    "honcho": {
      "type": "local",
      "command": [
        "bun",
        "run",
        "/home/geert/honcho/mcp/src/local.ts"
      ],
      "environment": {
        "HONCHO_API_URL": "http://localhost:8000/v3",
        "HONCHO_API_KEY": "${HONCHO_API_KEY}",
        "HONCHO_USER_NAME": "geert",
        "HONCHO_WORKSPACE_ID": "default"
      },
      "enabled": false
    },
    "ms365": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@softeria/ms-365-mcp-server",
        "--org-mode",
        "--enabled-tools",
        "list-mail|send-mail|list-calendar|get-calendar-events|create-calendar-event|update-calendar-event|delete-calendar-event|get-calendar-view|list-joined-teams|list-team-channels|send-channel-message|list-chats|get-chat|send-chat-message"
      ],
      "enabled": false
    },
    "minutes-mcp": {
      "type": "local",
      "command": [
        "bun",
        "run",
        "/home/geert/Code/personal/minutes/crates/mcp/src/index.ts"
      ],
      "enabled": false
    },
    "qmd": {
      "type": "local",
      "command": [
        "qmd",
        "mcp"
      ],
      "enabled": true
    }
  },
  "plugin": [
    "@honcho-ai/opencode-honcho"
  ],
  "command": {
    "honcho:config": {
      "description": "Change shared OpenCode Honcho config values.",
      "template": "Use the native Honcho config UI backed by `~/.honcho/config.json`. Show the available config fields, verify the selected field still exists case-insensitively in `~/.honcho/config.json`, then ask `What should it be set to:`. If the field has presets, ask `What should it be set to: <preset options>`. If `~/.honcho/config.json` does not exist, tell the user that the config does not exist there."
    }
  }
}
