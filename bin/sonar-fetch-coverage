#!/usr/bin/env bash
set -euo pipefail

# sonar-fetch-coverage — Fetch SonarCloud coverage metrics for a PR
# Usage: sonar-fetch-coverage <PR_NUMBER> <PROJECT_KEY> [BASE_URL]
#
# Requires: SONARQUBE_TOKEN environment variable
# AIDEV-NOTE: Callable from any working directory — path-independent

PR_NUMBER="${1:?Usage: sonar-fetch-coverage <PR_NUMBER> <PROJECT_KEY> [BASE_URL]}"
PROJECT_KEY="${2:?Error: PROJECT_KEY required}"
BASE_URL="${3:-https://sonarcloud.io/api}"

if [ -z "${SONARQUBE_TOKEN:-}" ]; then
  echo "ERROR: SONARQUBE_TOKEN not set. Export it with: export SONARQUBE_TOKEN=your_token" >&2
  exit 1
fi

curl -s -u "${SONARQUBE_TOKEN}:" \
  "${BASE_URL}/measures/component?component=${PROJECT_KEY}&pullRequest=${PR_NUMBER}&metricKeys=coverage,new_coverage,new_line_coverage,uncovered_lines,lines_to_cover,branch_coverage,new_branch_coverage,new_lines_to_cover"