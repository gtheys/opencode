#!/usr/bin/env node

/**
 * sonar-analyze-coverage — Analyze SonarCloud coverage metrics
 * Usage: sonar-analyze-coverage <PR_NUMBER> <coverage_json_path>
 */

const fs = require('fs');

const prNumber = process.argv[2];
const coveragePath = process.argv[3] || `/tmp/sonar_coverage_${prNumber}.json`;

if (!prNumber) {
  console.error('Usage: sonar-analyze-coverage <PR_NUMBER> [coverage_json_path]');
  process.exit(1);
}

// Parse coverage data
const coverageData = JSON.parse(fs.readFileSync(coveragePath, 'utf8'));
const measures = coverageData.component?.measures || [];

// Extract coverage metrics (handle both period-based and direct values)
const metrics = {};
measures.forEach(m => {
  // Periods are used for "new code" metrics
  if (m.periods && m.periods.length > 0) {
    metrics[m.metric] = parseFloat(m.periods[0].value) || 0;
  } else {
    metrics[m.metric] = parseFloat(m.value) || 0;
  }
});

const overallCoverage = metrics.coverage || 0;
const newLineCoverage = metrics.new_line_coverage || 0;
const newCoverage = metrics.new_coverage || newLineCoverage || 0;
const branchCoverage = metrics.branch_coverage || 0;
const newBranchCoverage = metrics.new_branch_coverage || 0;
const uncoveredLines = parseInt(metrics.uncovered_lines || 0);
const linesToCover = parseInt(metrics.lines_to_cover || 0);

// Determine coverage status and gaps
const coverageGap = Math.max(0, 80 - overallCoverage);
const newCoverageGap = Math.max(0, 80 - newLineCoverage);
const branchGap = Math.max(0, 80 - branchCoverage);
const newBranchGap = Math.max(0, 80 - newBranchCoverage);

function statusIcon(val, threshold = 80) {
  if (val >= threshold) return '✅';
  if (val >= threshold - 10) return '⚠️';
  return '❌';
}

// AIDEV-NOTE: Structured coverage analysis output
console.log(JSON.stringify({
  overallCoverage,
  newLineCoverage,
  newCoverage,
  branchCoverage,
  newBranchCoverage,
  uncoveredLines,
  linesToCover,
  gaps: {
    overall: coverageGap,
    newCode: newCoverageGap,
    branch: branchGap,
    newBranch: newBranchGap
  },
  status: {
    overall: overallCoverage >= 80 ? 'PASS' : 'FAIL',
    newCode: newLineCoverage >= 80 ? 'PASS' : 'FAIL',
    branch: branchCoverage >= 80 ? 'PASS' : 'FAIL',
    newBranch: newBranchCoverage >= 80 ? 'PASS' : 'FAIL'
  },
  icons: {
    overall: statusIcon(overallCoverage),
    newCode: statusIcon(newLineCoverage),
    branch: statusIcon(branchCoverage),
    newBranch: statusIcon(newBranchCoverage)
  }
}, null, 2));